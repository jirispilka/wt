#!/usr/bin/env bash
# wt add    [repo-dir] <branch-name> [base-branch]
#   Creates a git worktree + a dedicated KDE Activity, then opens wezterm + IDE
#   + Chrome in it. repo-dir defaults to the repo containing $PWD.
# wt remove [[repo-dir] <branch-name>]
#   Removes the worktree, deletes the branch (if merged), closes the activity's
#   windows and removes the KDE Activity. With no arguments, infers the worktree
#   from $PWD (run it from inside the worktree you want gone).
set -euo pipefail

script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# optional user config (see config.example); the file wins, defaults below fill the rest
wt_config="${XDG_CONFIG_HOME:-$HOME/.config}/wt/config"
[ -r "$wt_config" ] && . "$wt_config"
: "${WT_REPOS:=}"                  # parent dirs searched for a bare repo name
: "${WT_IDE:=webstorm}"            # run as: $WT_IDE <worktree-path>
: "${WT_CHROME_PROFILE:=Default}"  # Chrome --profile-directory value
: "${WT_URLS:=}"                   # extra Chrome tabs, space-separated
: "${WT_DASHBOARD_ACTIVITY:=Work}" # where 'wt dashboard' puts the cloud card
: "${WT_WINDOW_CLASSES:=jetbrains-webstorm org.wezfurlong.wezterm google-chrome}"
: "${WT_REPO_MARKS:=}"             # pin a repo color: "<repo>:<color>[:<emoji>]" …
# Card sizes, "<width> <height>" in pixels, passed to addWidget unquoted. A
# desktop applet is sized once at creation and never resizes to its content
# (see plasmoid/…/ui/main.qml), so these numbers are the whole layout. Wider
# buys less eliding on both cards; taller only helps the cloud card, whose
# list grows with the session count — the branch card is a fixed 7 rows.
: "${WT_CARD_CLOUD:=1240 760}"
: "${WT_CARD_BRANCH:=1000 170}"

am="org.kde.ActivityManager"
amp="/ActivityManager/Activities"
ami="org.kde.ActivityManager.Activities"
kwin="org.kde.KWin"
kwins="/Scripting"
kwini="org.kde.kwin.Scripting"

usage() {
  echo "usage: wt add [repo] <branch> | -b <new-branch> [base] | <session-id>" >&2
  echo "       wt remove [-f] [[repo] <branch-name> | <number>]" >&2
  echo "       wt list | wt switch [number] | wt cloud | wt dashboard [activity]" >&2
  echo "run 'wt --help' for details" >&2
  exit 1
}

help() {
  cat <<'EOF'
wt — one git worktree = one KDE Activity (wezterm + IDE + Chrome)

USAGE
  wt add [repo] <branch> [--session <url|id>]     worktree + activity, switch to it
  wt add [repo] -b <branch> [base]                create the branch first
  wt add [repo] <session-id|claude.ai/code url>   branch comes from that session
  wt remove [-f] [[repo] <branch> | <number>]     windows, worktree, branch, activity
  wt list                                         numbered entries + cloud sessions
  wt switch [number]                              fzf picker, or jump to entry n
  wt cloud [--all]                                claude.ai/code sessions, urgent first
  wt dashboard [activity]                         (re)install every board card

  repo defaults to the repo containing $PWD; else a path holding .git, or a bare
  repo name found under $WT_REPOS. The worktree is ~/.worktrees/<repo>/<branch>,
  the activity "<repo>: <branch>". add is idempotent: re-running reuses both.

ADD
  Opens wezterm, $WT_IDE and Chrome pinned to the new activity. Chrome gets the
  branch's PR, else the branch on GitHub, else the repo — plus the tied session.

  Branch resolution is git-like, a branch is only born with -b:
    exists locally    -> checked out
    on origin only    -> tracking branch created (push updates the PR)
    neither           -> refused, with the -b line to run
    -b <branch>       -> created off base (default: the main checkout's HEAD),
                         refused if it already exists

  A session id (session_…, cse_…) or claude.ai/code URL in place of the branch
  uses the branch that session works on and ties the worktree to it — if the
  session never pushed it, the branch is created here so you can carry on.
  --session <url|id> ties a session to a worktree after the fact. Not needed
  when the PR body links it: wt-status finds that by itself.

REMOVE
  Windows close gracefully (unsaved-changes dialogs survive); the branch is
  deleted only if merged. No arguments: run it inside the worktree. A branch
  name is resolved across ~/.worktrees, a number is a wt-list entry.
  -f: remove a dirty worktree and delete an unmerged branch (squash-merged PRs
  always look unmerged to git). Both throw work away.

LIST / SWITCH
  Numbered: $WT_DASHBOARD_ACTIVITY first, other plain activities, then every
  worktree with agent (claude/codex), PR, CI and review status, Personal last;
  ● is current. The numbers feed 'wt switch <n>' and 'wt remove <n>'
  (Meta+1..4 are bound to entries 1-4). The trailing 'cloud elsewhere' block is
  the sessions with no worktree here — the rest show up as a row's cloud chip.

CLOUD
  Recent sessions, 'needs you' (a live prompt) first, then failed, working,
  'your turn' (last turn ended on a question), done — with branch, age and the
  note the session left. Branches are OSC-8 links: ctrl-click opens the session.
  Idle >7d is hidden, --all shows everything. Read-only.

DASHBOARD
  Cloud card on one plain activity, branch card on every worktree activity.
  Cards are recreated, so position survives but a manual resize does not (a
  desktop applet cannot be resized through the scripting API). An activity needs
  to have been visited once, or Plasma has not created its desktop yet.

CONFIG  ~/.config/wt/config, plain shell, all optional — see config.example
  WT_REPOS WT_IDE WT_CHROME_PROFILE WT_URLS WT_DASHBOARD_ACTIVITY
  WT_WINDOW_CLASSES WT_CARD_CLOUD WT_CARD_BRANCH WT_REPO_MARKS

EXAMPLES
  wt add fix/timeout                       # existing branch, local or on origin
  wt add -b fix/timeout master             # new branch off master
  wt add apify-core fix/timeout            # bare repo name, found via $WT_REPOS
  wt add session_01GaQ7VgYvm3m865aY4HEWbE  # the branch that session works on
  wt remove                                # from inside the worktree
EOF
  exit 0
}

# Install or repair one wt board card on an activity's desktops, and drop the
# Command Output card it replaced. Prints the number of desktops touched.
# <activity-id> <command> <replaced-command-match> <w> <h> <interval-ms>
install_board() {
  if [ ! -d "$HOME/.local/share/plasma/plasmoids/org.kde.wt.board" ]; then
    echo "wt: board plasmoid not installed — see the README (Install)" >&2
    return 1
  fi
  # A desktop applet keeps the geometry it was created with — Widget.geometry
  # is read-only here — so resizing means recreating it. Position is kept.
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var ds = desktopsForActivity(\"$1\"), n = 0;
        for (var i = 0; i < ds.length; i++) {
            var old = ds[i].widgets(\"com.github.zren.commandoutput\");
            for (var j = 0; j < old.length; j++) {
                old[j].currentConfigGroup = [\"General\"];
                if (old[j].readConfig(\"command\").indexOf(\"$3\") !== -1) old[j].remove();
            }
            var x = 40, y = 40;
            var ws = ds[i].widgets(\"org.kde.wt.board\");
            for (var j = 0; j < ws.length; j++) {
                // keep the old spot verbatim: a containment's coordinate space
                // can start well below zero, so 'negative' is not 'invalid'
                if (ws[j].geometry.width > 0) { x = ws[j].geometry.x; y = ws[j].geometry.y; }
                ws[j].remove();
            }
            var w = ds[i].addWidget(\"org.kde.wt.board\", x, y, $4, $5);
            w.currentConfigGroup = [\"General\"];
            w.writeConfig(\"command\", \"$2\");
            w.writeConfig(\"interval\", $6);
            n++;
        }
        print(n);"
}

find_activity() {
  for id in $(qdbus6 "$am" "$amp" "$ami.ListActivities"); do
    if [ "$(qdbus6 "$am" "$amp" "$ami.ActivityName" "$id")" = "$1" ]; then
      echo "$id"
      return
    fi
  done
}

[ $# -ge 1 ] || usage
cmd="$1"
shift
case "$cmd" in
add | remove | list | switch | cloud | dashboard) ;;
-h | --help | help) help ;;
*) usage ;;
esac
case "${1:-}" in -h | --help) help ;; esac

norm_session() { # <claude.ai/code url | session_… | cse_… id> -> canonical URL
  case "$1" in
  https://claude.ai/code/session_*) printf '%s\n' "$1" ;;
  session_*) printf 'https://claude.ai/code/%s\n' "$1" ;;
  cse_*) printf 'https://claude.ai/code/session_%s\n' "${1#cse_}" ;; # api form
  *) return 1 ;;
  esac
}

# -f/--force (remove only): force dirty-worktree removal + unmerged-branch deletion
# -b (add only): create the branch, like git checkout -b
# --session (add only): the claude.ai/code session this worktree continues
force="" session="" newbranch="" from_session=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
  -f | --force) force=1 ;;
  -b) newbranch=1 ;;
  --session)
    [ $# -ge 2 ] || usage
    session="$2"
    shift
    ;;
  --session=*) session="${1#*=}" ;;
  # branch names and repo dirs never start with '-', so an unknown dash arg is a
  # typo — silently treating it as a positional made 'wt add -b x --session-id y'
  # take "--session-id" as the base branch and fail deep inside git instead.
  -*)
    echo "wt: unknown option '$1'" >&2
    usage
    ;;
  *) args+=("$1") ;;
  esac
  shift
done
set -- ${args[@]+"${args[@]}"}
[ -n "$force" ] && [ "$cmd" != remove ] && usage
{ [ -n "$session" ] || [ -n "$newbranch" ]; } && [ "$cmd" != add ] && usage
if [ -n "$session" ]; then
  session=$(norm_session "$session") || {
    echo "wt: --session wants https://claude.ai/code/session_… or a bare session_… id" >&2
    exit 1
  }
fi

# Only colorize when the output is a terminal. The per-entry status bodies come
# pre-colored from wt-status and get stripped further down, but the cloud
# heading is printed outside that pipeline, so it leaked escapes into `wt list |
# cat` until these were gated too.
if [ -t 1 ]; then
  bold=$'\e[1m' dim=$'\e[2m' green=$'\e[32m' rst=$'\e[0m'
else
  bold='' dim='' green='' rst=''
fi

list_worktrees() {
  # linked worktrees have a .git *file*; branch names may contain slashes
  find "$HOME/.worktrees" -maxdepth 5 -name .git -type f 2>/dev/null |
    sort | while IFS= read -r g; do dirname "$g"; done
}

wt_name() { # <worktree-path> -> "<repo>: <branch>" (the activity name)
  # The PATH is the join key, never the live checkout. `git checkout` inside a
  # worktree used to rename the activity out from under wt switch, wt-cloud's
  # branch->worktree mapping and wt-activity-watch's -d test, splitting one
  # worktree into two entries — one of which pointed at no activity at all.
  # Detached HEAD used to produce "<repo>: " for the same reason. This is the
  # encoding wt-cloud's worktrees() already reads, so now they agree.
  # Kept a self-contained block: wt-tests.sh sed-extracts /^wt_name()/,/^}/.
  local rel="${1#"$HOME/.worktrees/"}"
  printf '%s: %s\n' "${rel%%/*}" "${rel#*/}"
}

repo_mark() { # <repo> -> "<emoji>\t<ansi-256>\t<icon>" — one slot, three renderings
  # Repos are told apart by color, and the same slot has to survive three very
  # different renderers: the ANSI tint in `wt list`, the Breeze folder-<color>
  # icon in the activity switcher (the activity NAME is the join key, so a
  # marker cannot go there), and the circle emoji — which is what is left once
  # `wt list | cat` strips the escapes. Hence one palette, not three.
  # The slot comes from the name itself, so it is stable forever with no state
  # to keep; WT_REPO_MARKS ("<repo>:<color>[:<emoji>]" …) overrides a repo.
  # Kept a self-contained block: wt-tests.sh sed-extracts /^repo_mark()/,/^}/.
  local palette=(red:203:🔴 orange:215:🟠 yellow:221:🟡 green:114:🟢
    blue:75:🔵 violet:141:🟣 brown:137:🟤 grey:245:⚪)
  local entry rest want="" emoji="" slot=""
  for entry in ${WT_REPO_MARKS:-}; do
    case "$entry" in
    "$1":*)
      rest="${entry#*:}" want="${rest%%:*}"
      # a two-field entry picks the color only, and keeps the slot's circle
      [ "$rest" = "$want" ] || emoji="${rest#*:}"
      ;;
    esac
  done
  for entry in "${palette[@]}"; do
    [ "${entry%%:*}" = "$want" ] && slot="$entry"
  done
  if [ -z "$slot" ]; then # unset, or a color name that is not in the palette
    slot="${palette[$(printf '%s' "$1" | cksum | cut -d" " -f1) % ${#palette[@]}]}"
  fi
  rest="${slot#*:}"
  printf '%s\t%s\tfolder-%s\n' "${emoji:-${rest#*:}}" "${rest%%:*}" "${slot%%:*}"
}

# The numbered entry list shared by list/switch/remove: WT_DASHBOARD_ACTIVITY
# (e.g. Work) pinned first, other plain activities, then wt worktrees, Personal
# pinned last. qdbus's ListActivities order is otherwise arbitrary (activity
# creation order), so Work/Personal must be pinned explicitly, not assumed.
# Fills entry_names[] and entry_paths[] (empty path = plain activity).
build_entries() {
  entry_names=() entry_paths=()
  local p id name w skip i
  local wt_paths=() wt_names=() work=() pre=() post=()
  while IFS= read -r p; do
    wt_paths+=("$p")
    wt_names+=("$(wt_name "$p")")
  done < <(list_worktrees)
  for id in $(qdbus6 "$am" "$amp" "$ami.ListActivities" 2>/dev/null); do
    name=$(qdbus6 "$am" "$amp" "$ami.ActivityName" "$id" 2>/dev/null)
    skip=""
    for w in ${wt_names[@]+"${wt_names[@]}"}; do
      [ "$name" = "$w" ] && skip=1
    done
    [ -n "$skip" ] && continue
    case "$name" in
    Personal) post+=("$name") ;;
    "$WT_DASHBOARD_ACTIVITY") work+=("$name") ;;
    *) pre+=("$name") ;;
    esac
  done
  for name in ${work[@]+"${work[@]}"} ${pre[@]+"${pre[@]}"}; do
    entry_names+=("$name")
    entry_paths+=("")
  done
  for i in "${!wt_paths[@]}"; do
    entry_names+=("${wt_names[i]}")
    entry_paths+=("${wt_paths[i]}")
  done
  for name in ${post[@]+"${post[@]}"}; do
    entry_names+=("$name")
    entry_paths+=("")
  done
}

case "$cmd" in
list)
  # Both producers write into a capture below, so their own isatty() says no.
  # Only this process knows whether the rendered list reaches a terminal, and
  # OSC 8 links are worth emitting only if it does. `if`, not `&&`: a false
  # test as a bare command would trip set -e.
  # Same reason wt-cloud cannot measure the width it renders into and assumes a
  # narrow one — which cost the note its room once the title moved in.
  if [ -t 1 ]; then export WT_TTY=1 COLUMNS="$(tput cols 2>/dev/null || echo 100)"; fi
  build_entries
  cur_name=""
  cur=$(qdbus6 "$am" "$amp" "$ami.CurrentActivity" 2>/dev/null) &&
    cur_name=$(qdbus6 "$am" "$amp" "$ami.ActivityName" "$cur" 2>/dev/null)
  # fan the status calls out in parallel (each may hit GitHub when its
  # cache is stale) — wall time is the slowest row, not the sum
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  for i in "${!entry_names[@]}"; do
    [ -n "${entry_paths[i]}" ] && "$script_dir/wt-status" "${entry_paths[i]}" plain >"$tmp/$i" &
  done
  wait
  # bold branch, repo in its own per-repo color, status folded onto one line;
  # ANSI is stripped when stdout is not a terminal (the status arrives
  # pre-colored) — which is why the repo also carries repo_mark's emoji, the
  # half of the marker that survives the strip.
  for i in "${!entry_names[@]}"; do
    name="${entry_names[i]}"
    mark="  "
    [ "$name" = "$cur_name" ] && mark="$green●$rst "
    if [ -n "${entry_paths[i]}" ]; then
      IFS=$'\t' read -r r_emoji r_ansi _ <<<"$(repo_mark "${name%%: *}")"
      # not [ -t 1 ]: this loop runs inside the strip pipeline below, so its
      # own stdout is never the terminal. $rst was gated up top, where it was.
      r_color=""
      [ -n "$rst" ] && r_color=$'\e[38;5;'"$r_ansi"m
      printf '%2d %s%s%s%s %s%s %s%s\n' "$((i + 1))" "$mark" "$bold" "${name#*: }" "$rst" \
        "$r_color" "$r_emoji" "${name%%: *}" "$rst"
      body=""
      while IFS= read -r l; do
        body="${body:+$body $dim·$rst }$l"
      done <"$tmp/$i"
      printf '     %s\n\n' "$body"
    else
      printf '%2d %s%s%s%s %sactivity%s\n\n' "$((i + 1))" "$mark" "$bold" "$name" "$rst" "$dim" "$rst"
    fi
  done | { [ -t 1 ] && cat || sed -E $'s/\x1b\\[[0-9;]*m//g'; }
  [ "${#entry_names[@]}" -gt 0 ] || echo "no activities or worktrees found"
  # claude.ai/code sessions with no worktree here — work you'd otherwise only
  # see by opening the browser. Branches that do have a worktree are already
  # covered by their row's cloud chip, so hand them over to be skipped.
  if [ -x "$script_dir/wt-cloud" ]; then
    mine=()
    for i in "${!entry_names[@]}"; do
      [ -n "${entry_paths[i]}" ] && mine+=("${entry_names[i]#*: }")
    done
    if cloud=$("$script_dir/wt-cloud" list ${mine[@]+"${mine[@]}"} 2>/dev/null |
      sed 's/^/   /') && [ -n "$cloud" ]; then
      printf '   %scloud%s %selsewhere%s\n%s\n\n' "$bold" "$rst" "$dim" "$rst" "$cloud"
    fi
  fi
  exit 0
  ;;
cloud)
  exec "$script_dir/wt-cloud" list "$@"
  ;;
dashboard)
  # Install/repair every wt card: the cloud session list on one plain activity
  # (default Work) plus a branch card on each worktree activity. Separate from
  # 'wt add' so widgets can be fixed without reopening the whole workspace.
  act_name="${1:-$WT_DASHBOARD_ACTIVITY}"
  activity_id="$(find_activity "$act_name")"
  [ -n "$activity_id" ] || {
    echo "wt: no activity named '$act_name'" >&2
    exit 1
  }
  n=$(install_board "$activity_id" "$script_dir/wt-cloud json" wt-cloud $WT_CARD_CLOUD 10000) ||
    exit 1
  if [ "${n:-0}" = 0 ]; then
    echo "wt: activity '$act_name' has no desktop yet — switch to it once, then re-run" >&2
    exit 1
  fi
  echo "cloud sessions on '$act_name'"
  build_entries
  for i in "${!entry_names[@]}"; do
    [ -n "${entry_paths[i]}" ] || continue
    id="$(find_activity "${entry_names[i]}")"
    [ -n "$id" ] || continue
    # repaint the repo-color icon too: it is set on 'add', so a worktree
    # activity created before repo_mark existed (or added before a
    # WT_REPO_MARKS edit) only picks up the current color here
    IFS=$'\t' read -r _ _ repo_icon <<<"$(repo_mark "${entry_names[i]%%: *}")"
    qdbus6 "$am" "$amp" "$ami.SetActivityIcon" "$id" "$repo_icon" || true
    install_board "$id" "$script_dir/wt-status ${entry_paths[i]}" \
      wt-status $WT_CARD_BRANCH 5000 >/dev/null && echo "branch card on '${entry_names[i]}'"
  done
  exit 0
  ;;
switch)
  # a non-numeric argument is an activity name, used straight — that is how the
  # board widget jumps to a branch, and it skips the whole entry scan
  name=""
  case "${1:-}" in
  "") ;;
  *[!0-9]*) name="$1" ;;
  esac
  if [ -n "$name" ]; then
    :
  elif [ -n "${1:-}" ]; then
    build_entries
    [ "$1" -ge 1 ] && name="${entry_names[$1 - 1]:-}" || name=""
    [ -n "$name" ] || {
      echo "no entry #$1 (see wt list)" >&2
      exit 1
    }
  else
    build_entries
    # the picker IS the list: live agent + cached PR status per row
    # (preview mode = no gh, no qdbus), gathered in parallel
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    for i in "${!entry_names[@]}"; do
      [ -n "${entry_paths[i]}" ] && "$script_dir/wt-status" "${entry_paths[i]}" preview >"$tmp/$i" &
    done
    wait
    sel=$(for i in "${!entry_names[@]}"; do
      n="${entry_names[i]}"
      if [ -n "${entry_paths[i]}" ]; then
        body=""
        while IFS= read -r l; do
          body="${body:+$body $dim·$rst }$l"
        done <"$tmp/$i"
        printf '%d %s%s%s %s%s%s  %s\t%s\n' "$((i + 1))" \
          "$bold" "${n#*: }" "$rst" "$dim" "${n%%: *}" "$rst" "$body" "$n"
      else
        printf '%d %s%s%s\t%s\n' "$((i + 1))" "$bold" "$n" "$rst" "$n"
      fi
    done | fzf --ansi --delimiter='\t' --with-nth=1) || exit 0
    name="${sel##*$'\t'}"
  fi
  activity_id="$(find_activity "$name")"
  if [ -z "$activity_id" ]; then
    echo "no activity named '$name' — create it with: wt add ${name#*: }" >&2
    exit 1
  fi
  qdbus6 "$am" "$amp" "$ami.SetCurrentActivity" "$activity_id"
  exit 0
  ;;
esac

# Optional repo-dir: recognized by containing .git (branch names never do), or
# by naming a repo under $WT_REPOS — 'wt add apify-mcp-server fix/x' from
# anywhere. The bare-name form needs a second argument, so a lone branch that
# happens to share a repo's name is still read as a branch.
repo_dir="$PWD"
explicit_repo=""
if [ $# -ge 1 ] && [ -e "$1/.git" ]; then
  repo_dir="$1"
  explicit_repo=1
  shift
elif [ $# -ge 2 ]; then
  for d in $WT_REPOS; do # unquoted: space-separated list
    [ -e "$d/$1/.git" ] || continue
    repo_dir="$d/$1"
    explicit_repo=1
    shift
    break
  done
fi
branch="${1:-}"
base="${2:-}"

# 'wt add <session-id|url>' / 'wt add --session <…>' — take the branch from the
# cloud session, which is how work started on claude.ai/code lands here.
case "$branch" in
session_* | cse_* | https://claude.ai/code/*)
  session=$(norm_session "$branch") || {
    echo "wt: '$branch' is not a session" >&2
    exit 1
  }
  branch=""
  ;;
esac
if [ -z "$branch" ] && [ -n "$session" ]; then
  branch=$("$script_dir/wt-cloud" branch "$session" \
    "$(git -C "$repo_dir" remote get-url origin 2>/dev/null)") || branch=""
  if [ -z "$branch" ]; then
    echo "wt: $session has no branch yet — give it something to work on first" >&2
    exit 1
  fi
  case "$branch" in *"
"*)
    echo "wt: that session has several branches, pick one:" >&2
    printf '  %s\n' $branch >&2
    exit 1
    ;;
  esac
  echo "session branch: $branch"
  # the API reports the branch the session made in its own sandbox, pushed or
  # not — so a missing branch here means "not pushed yet", not "typo"
  from_session=1
fi

worktree_path=""
if [ -z "$branch" ]; then
  # No branch given: infer the worktree from $PWD (remove only).
  [ "$cmd" = "remove" ] || usage
  worktree_path="$(git rev-parse --show-toplevel)"
  if [ "$(git rev-parse --absolute-git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
    echo "not inside a linked worktree — pass <branch-name> explicitly" >&2
    exit 1
  fi
  branch="$(git branch --show-current)"
  if [ -z "$branch" ]; then
    echo "detached HEAD — pass <branch-name> explicitly" >&2
    exit 1
  fi
  repo_dir="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
fi

# remove: also accept a wt-list number, or a branch checked out in any
# ~/.worktrees worktree — so removal works from anywhere.
if [ "$cmd" = remove ] && [ -n "$branch" ] && [ -z "$explicit_repo" ] && [ -z "$worktree_path" ]; then
  resolved=""
  case "$branch" in
  *[!0-9]*) # branch name — scan wt-managed worktrees for it
    matches=()
    while IFS= read -r p; do
      [ "$(git -C "$p" branch --show-current 2>/dev/null)" = "$branch" ] && matches+=("$p")
    done < <(list_worktrees)
    if [ "${#matches[@]}" -eq 1 ]; then
      resolved="${matches[0]}"
    elif [ "${#matches[@]}" -gt 1 ]; then
      echo "branch '$branch' is checked out in several worktrees:" >&2
      printf '  %s\n' "${matches[@]}" >&2
      echo "disambiguate with: wt remove <repo-dir> $branch" >&2
      exit 1
    fi
    # 0 matches: fall through to the PWD-based logic below
    ;;
  *) # wt-list number (same numbering as wt list / wt switch)
    build_entries
    resolved=""
    [ "$branch" -ge 1 ] && resolved="${entry_paths[$branch - 1]:-}"
    if [ -z "$resolved" ]; then
      if [ "$branch" -ge 1 ] && [ -n "${entry_names[$branch - 1]:-}" ]; then
        echo "#$branch is activity '${entry_names[$branch - 1]}', not a worktree" >&2
      else
        echo "no entry #$branch (see wt list)" >&2
      fi
      exit 1
    fi
    ;;
  esac
  if [ -n "$resolved" ]; then
    worktree_path="$resolved"
    branch=$(git -C "$resolved" branch --show-current)
    repo_dir=$(dirname "$(git -C "$resolved" rev-parse --path-format=absolute --git-common-dir)")
  fi
fi

# A repo-dir argument is only recognized as one if it holds a .git entry, so a
# bare repo name lands here as a branch and $PWD stays the repo — say that,
# instead of letting git's bare "fatal: not a git repository" out.
# assigned via a second variable: a failing command substitution would blank
# $repo_dir before the message that has to name it
toplevel="$(git -C "$repo_dir" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "wt: '$repo_dir' is not a git repo — cd into the repo, or name it:" >&2
  echo "    wt $cmd /path/to/repo ${branch:-<branch>}   (bare names: WT_REPOS)" >&2
  exit 1
}
repo_dir="$toplevel"
repo_name="$(basename "$repo_dir")"
[ -n "$worktree_path" ] || worktree_path="$HOME/.worktrees/$repo_name/$branch"
# The activity name is path-derived (wt_name), like everywhere else — never the
# live checkout. `git checkout` inside a worktree otherwise made `wt remove`
# look for "<repo>: <checked-out-branch>", an activity that never existed, and
# leave the real one orphaned with no worktree to remove it by.
case "$worktree_path" in
"$HOME/.worktrees/"*) activity_name="$(wt_name "$worktree_path")" ;;
*) activity_name="$repo_name: $branch" ;; # remove from a worktree elsewhere
esac

case "$cmd" in
add)
  if git -C "$repo_dir" worktree list --porcelain | grep -qxF "worktree $worktree_path"; then
    echo "worktree already exists at $worktree_path, reusing"
  else
    # Resolve the branch BEFORE creating any directory, so a refusal leaves
    # nothing behind. Like git: a branch is only born with -b.
    local_ref="" remote_ref="" origin_down=""
    git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch" && local_ref=1
    # '|| rc=$?' not a bare call: set -e would abort before we read the code
    rc=0
    git -C "$repo_dir" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 || rc=$?
    case $rc in
    0) remote_ref=1 ;;
    2) ;; # ran fine: origin has no such branch
    *)
      origin_down=1 # offline, no ssh agent, … — must not claim it is missing
      echo "warning: could not reach origin, going on local refs alone" >&2
      ;;
    esac
    if [ -n "$newbranch" ] && { [ -n "$local_ref" ] || [ -n "$remote_ref" ]; }; then
      echo "wt: branch '$branch' already exists — drop -b to check it out" >&2
      exit 1
    fi
    if [ -z "$newbranch" ] && [ -z "$local_ref" ] && [ -z "$remote_ref" ]; then
      if [ -n "$origin_down" ]; then
        echo "wt: no local branch '$branch', and origin is unreachable" >&2
        exit 1
      elif [ -n "$from_session" ]; then
        # continuing a cloud session that has not pushed: the branch exists only
        # in its sandbox, so create it here (off HEAD) rather than refusing —
        # asking for -b would just retype a name the session already chose
        echo "'$branch' not pushed yet — creating it off ${base:-$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD)}"
        newbranch=1
      else
        echo "wt: no branch '$branch' here or on origin" >&2
        # repeat the repo when it came from an argument: pasting the hint from
        # outside the repo would otherwise fail with 'not a git repo'
        echo "    create it with: wt add ${explicit_repo:+$repo_dir }-b $branch ${base:-[base-branch]}" >&2
        exit 1
      fi
    fi
    mkdir -p "$(dirname "$worktree_path")"
    if [ -n "$newbranch" ]; then
      git -C "$repo_dir" worktree add -b "$branch" "$worktree_path" ${base:+"$base"}
    elif [ -n "$local_ref" ]; then
      echo "branch '$branch' already exists, checking it out"
      git -C "$repo_dir" worktree add "$worktree_path" "$branch"
    else
      echo "branch '$branch' exists on origin, checking out tracking branch"
      git -C "$repo_dir" fetch origin "$branch"
      git -C "$repo_dir" worktree add --track -b "$branch" "$worktree_path" "origin/$branch"
    fi
  fi

  # The cloud-session link lives in the worktree's gitdir (outside the working
  # tree, so it never shows up as a change, and it dies with the worktree).
  # wt-status reads the same file — and refreshes it from the PR body.
  session_file="$(git -C "$worktree_path" rev-parse --absolute-git-dir)/wt-session"
  if [ -n "$session" ]; then
    printf '%s\n' "$session" >"$session_file"
  else
    session=$(cat "$session_file" 2>/dev/null) || session=""
    # first add of a branch a cloud session pushed: ask which session that was
    if [ -z "$session" ] && [ -x "$script_dir/wt-cloud" ]; then
      session=$("$script_dir/wt-cloud" lookup "$branch" \
        "$(git -C "$worktree_path" remote get-url origin 2>/dev/null)" \
        2>/dev/null | cut -f3) || session=""
      [ -n "$session" ] && printf '%s\n' "$session" >"$session_file"
    fi
  fi
  [ -n "$session" ] && echo "claude.ai session: $session"

  activity_id="$(find_activity "$activity_name")"
  [ -n "$activity_id" ] ||
    activity_id=$(qdbus6 "$am" "$amp" "$ami.AddActivity" "$activity_name")
  # Set on every add, not just on create: the switcher shows the name (the join
  # key, so no marker can go in it) plus the icon, which makes the icon the only
  # place a repo can be told from another at a glance — and activities created
  # before repo_mark existed still carry the old generic git-branch icon.
  # Non-fatal: wt add now does this every run, and a failed repaint of an icon
  # is no reason to abandon a worktree that is already on disk.
  IFS=$'\t' read -r _ _ repo_icon <<<"$(repo_mark "${activity_name%%: *}")"
  qdbus6 "$am" "$amp" "$ami.SetActivityIcon" "$activity_id" "$repo_icon" || true
  qdbus6 "$am" "$amp" "$ami.SetCurrentActivity" "$activity_id"

  # wt does not touch the desktop wallpaper. It used to set a per-repo solid
  # color via the org.kde.color plugin, whose config.qml (plasma-workspace
  # 6.6.5) never declares configDialog/wallpaperConfiguration — so kcm_wallpaper
  # threw on it and the wallpaper config UI stopped opening for the containment.
  # The activity name, icon and description are the only KDE state wt owns.

  # branch-status card on the activity desktop; idempotent, see install_board
  install_board "$activity_id" "$script_dir/wt-status $worktree_path" \
    wt-status $WT_CARD_BRANCH 5000 >/dev/null || true

  # ponytail: new windows don't reliably inherit the current activity on Wayland
  # (xdg-activation ties them to the launching terminal instead), so force it via
  # a throwaway KWin script. Only windows created AFTER this loads are assigned —
  # never existing ones. Unloads after 120s (WebStorm cold start + trust dialog);
  # unrelated wezterm/WebStorm windows opened during those 120s get pulled in too.
  kwin_script="$(mktemp --suffix=.js)"
  kwin_plugin="wt-assign-$activity_id"
  classes_js="$(printf '"%s",' $WT_WINDOW_CLASSES)"
  cat >"$kwin_script" <<EOF
var classes = [${classes_js%,}];
workspace.windowAdded.connect(function (w) {
    if (classes.indexOf(w.resourceClass) !== -1) {
        w.activities = ["$activity_id"];
    }
});
EOF
  qdbus6 "$kwin" "$kwins" "$kwini.unloadScript" "$kwin_plugin" >/dev/null 2>&1 || true
  qdbus6 "$kwin" "$kwins" "$kwini.loadScript" "$kwin_script" "$kwin_plugin" >/dev/null
  qdbus6 "$kwin" "$kwins" "$kwini.start" >/dev/null
  # fds redirected so the sleeper doesn't hold the caller's stdout/stderr open
  (
    sleep 120
    qdbus6 "$kwin" "$kwins" "$kwini.unloadScript" "$kwin_plugin" >/dev/null 2>&1
    rm -f "$kwin_script"
  ) >/dev/null 2>&1 &
  disown

  # setsid + /dev/null: fully detach GUI apps so their runtime warnings
  # (e.g. libwayland "proxies still attached") don't spill into the terminal
  setsid wezterm start --always-new-process --cwd "$worktree_path" >/dev/null 2>&1 &
  setsid $WT_IDE "$worktree_path" >/dev/null 2>&1 & # unquoted: WT_IDE may carry flags
  # Chrome tab: open PR for the branch if one exists, branch tree if pushed, repo root otherwise.
  gh_url=""
  if command -v gh >/dev/null 2>&1; then
    gh_url=$(cd "$worktree_path" && gh pr view --json url -q .url 2>/dev/null) || true
    if [ -z "$gh_url" ]; then
      gh_url=$(cd "$worktree_path" && gh repo view --json url -q .url 2>/dev/null) || true
      if [ -n "$gh_url" ] && git -C "$repo_dir" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
        gh_url="$gh_url/tree/$branch"
      fi
    fi
  fi
  # dedicated Chrome profile — isolates session/history from personal profiles
  setsid google-chrome --new-window --profile-directory="$WT_CHROME_PROFILE" \
    ${gh_url:+"$gh_url"} "${session:-https://claude.ai/code}" \
    $WT_URLS >/dev/null 2>&1 &
  ;;

remove)
  activity_id="$(find_activity "$activity_name")"

  # Git work first, while our terminal is alive to show errors (dirty
  # worktree, unmerged branch). Window closing comes last and detached.
  case "$PWD" in
  "$worktree_path" | "$worktree_path"/*) cd "$repo_dir" ;;
  esac
  git -C "$repo_dir" worktree remove ${force:+--force} "$worktree_path"
  rmdir -p "$(dirname "$worktree_path")" 2>/dev/null || true

  # WebStorm writes .idea on shutdown at its own pace, resurrecting the removed
  # directory. Janitor: sweep it later, but only if .idea is all there is.
  (
    sleep 30
    if [ -d "$worktree_path" ] && [ "$(ls -A "$worktree_path")" = ".idea" ]; then
      rm -rf "$worktree_path"
      rmdir -p "$(dirname "$worktree_path")" 2>/dev/null
    fi
  ) >/dev/null 2>&1 &
  disown

  del_flag="-d"
  [ -n "$force" ] && del_flag="-D"
  if ! git -C "$repo_dir" branch "$del_flag" "$branch" 2>/dev/null; then
    echo "branch '$branch' not deleted (unmerged?) — re-run with 'wt remove -f' if intended"
  fi

  if [ -z "$activity_id" ]; then
    echo "no activity found named '$activity_name'"
    exit 0
  fi

  # Closing the activity's windows may close the very terminal running this
  # script (wt remove from inside the activity), so the window-close +
  # activity-removal tail runs detached and survives our death.
  # closeWindow() is a graceful close request — apps with unsaved-changes
  # dialogs may survive it, which is intended.
  kwin_script="$(mktemp --suffix=.js)"
  kwin_plugin="wt-close-$activity_id"
  cat >"$kwin_script" <<EOF
workspace.windowList().forEach(function (w) {
    if (w.activities.indexOf("$activity_id") !== -1) {
        w.closeWindow();
    }
});
EOF
  teardown="$(mktemp --suffix=.sh)"
  cat >"$teardown" <<EOF
qdbus6 $kwin $kwins $kwini.unloadScript "$kwin_plugin" >/dev/null 2>&1
qdbus6 $kwin $kwins $kwini.loadScript "$kwin_script" "$kwin_plugin" >/dev/null
qdbus6 $kwin $kwins $kwini.start >/dev/null
sleep 2
qdbus6 $kwin $kwins $kwini.unloadScript "$kwin_plugin" >/dev/null 2>&1
qdbus6 $am $amp $ami.RemoveActivity "$activity_id"
rm -f "$kwin_script" "$teardown"
EOF
  setsid bash "$teardown" >/dev/null 2>&1 &
  disown
  echo "closing windows and removing activity '$activity_name'"
  ;;
esac
