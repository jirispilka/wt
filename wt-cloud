#!/usr/bin/env python3
"""wt-cloud — claude.ai/code sessions, without opening claude.ai.

  wt-cloud list [--all] [branch…]   recent cloud sessions, needs-you first
                                    (branch args: skip those, they are local)
  wt-cloud lookup <branch> [repo]   one TSV line (state, age, url) for a branch
  wt-cloud branch <session> [repo]  the branch a session works on (the reverse)
  wt-cloud json                     one card for the wt board plasmoid
  wt-cloud raw [match]              raw api records, for when the shape drifts
  wt-cloud refresh                  refresh the snapshot now

Snapshot: $XDG_CACHE_HOME/wt-status/cloud.json — normalized, non-secret fields
only. Refreshed when older than TTL; on failure the last good snapshot is kept
and its age is shown, so the widget never goes blank.

The Claude CLI OAuth token is read in-process and never logged, never persisted,
never passed as an argument. Read-only: no session is started, stopped, or
archived. Private API — all endpoint/field knowledge lives in fetch()/normalize()
so a response change breaks one place.
"""
import calendar
import glob
import json
import os
import shlex
import shutil
import sys
import time
import urllib.error
import urllib.request

WT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wt")

TTL = 30  # seconds a snapshot stays fresh
MAX_AGE = 7 * 86400  # older than this is archaeology, not a to-do; --all shows it
WINDOW = "%dd" % (MAX_AGE // 86400)  # how the window is spelled where it is shown
RANK = {"needs-you": 0, "failed": 1, "working": 2, "your-turn": 3, "done": 4}
GLYPH = {"needs-you": ("31;1", "!"), "failed": ("31", "✘"), "working": ("32", "●"),
         "your-turn": ("33", "?"), "done": ("2", "∙")}
# limit must outrun MAX_AGE: the api returns newest-first, so a small page
# silently truncates the window long before the age filter does
API = "https://api.anthropic.com/v1/code/sessions?limit=100"
CRED = os.path.expanduser("~/.claude/.credentials.json")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                     "wt-status")
SNAP = os.path.join(CACHE, "cloud.json")
LOCK = SNAP + ".lock"


def token():
    with open(CRED) as f:
        c = json.load(f)
    for k in ("claudeAiOauth", "oauth", "credentials"):
        if isinstance(c.get(k), dict):
            c = c[k]
            break
    tok = c.get("accessToken") or c.get("access_token")
    if not tok:
        raise RuntimeError("no OAuth token in ~/.claude/.credentials.json")
    return tok


def fetch():
    req = urllib.request.Request(API, headers={
        "authorization": "Bearer " + token(),
        "anthropic-version": "2023-06-01",
        "anthropic-beta": "oauth-2025-04-20,claude-code-20250219",
        "accept": "application/json",
        "user-agent": "wt-cloud/1",
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        raise RuntimeError("auth expired — run: claude" if e.code in (401, 403)
                           else "api http %d" % e.code)
    except Exception as e:
        raise RuntimeError("api unreachable (%s)" % type(e).__name__)
    if isinstance(body, dict):
        body = body.get("data") or body.get("sessions") or []
    if not isinstance(body, list):
        raise RuntimeError("api returned %s, expected a list" % type(body).__name__)
    return body


def slug(url):  # git remote or repo url -> "owner/repo"
    s = (url or "").strip()
    for cut in ("git@", "ssh://", "https://", "http://"):
        if s.startswith(cut):
            s = s[len(cut):]
    s = s.split("@")[-1].replace(":", "/", 1)
    if s.endswith(".git"):
        s = s[:-4]
    parts = [p for p in s.split("/") if p]
    return "/".join(parts[-2:]).lower() if len(parts) >= 2 else ""


def normalize(s):
    cfg = s.get("config") or {}
    meta = s.get("external_metadata") or {}
    turn = meta.get("post_turn_summary") or {}
    sid = s.get("id") or ""
    # the web URL uses a session_ prefix over the same id body as the api's cse_
    suffix = sid.split("_", 1)[-1]
    # pushed branches (outcomes) are authoritative; sources only e the repo
    heads, repos = [], []
    for o in cfg.get("outcomes") or []:
        gi = o.get("git_info") or {}
        if gi.get("repo"):
            repos.append(slug(gi["repo"]))
            heads += [(slug(gi["repo"]), b) for b in (gi.get("branches") or []) if b]
    for src in cfg.get("sources") or []:
        if src.get("url"):
            repos.append(slug(src["url"]))
    # worker_status is about right now, so requires_action is the only real
    # interrupt. The post-turn category describes how the last turn ENDED, and
    # ~every session ends by asking something — that is "your turn", a pending
    # item, not an alarm. status_bucket carries the same information.
    worker = s.get("worker_status") or "idle"
    if s.get("status") == "archived":
        state = "archived"
    elif worker == "running":
        state = "working"
    elif worker == "requires_action":
        state = "needs-you"
    elif turn.get("status_category") == "failed":
        state = "failed"
    elif turn.get("status_category") == "need_input":
        state = "your-turn"
    else:
        state = "done"
    return {
        "id": sid,
        "url": "https://claude.ai/code/session_" + suffix if suffix else "",
        "title": s.get("title") or "",
        "state": state,
        "detail": turn.get("status_detail") or "",
        "needs_action": turn.get("needs_action"),
        "category": turn.get("status_category") or "",
        "unread": bool(s.get("unread")),
        "repos": sorted({r for r in repos if r}),
        "heads": [list(h) for h in dict.fromkeys(heads)],
        "updated_at": s.get("last_event_at") or s.get("created_at") or "",
    }


def load():
    try:
        with open(SNAP) as f:
            return json.load(f)
    except Exception:
        return None


def refresh(force=False):
    """Return (snapshot, error). Never raises; keeps the last good snapshot."""
    snap = load()
    fresh = snap and time.time() - snap.get("at", 0) < (0 if force else TTL)
    if fresh:
        return snap, ""
    os.makedirs(CACHE, exist_ok=True)
    try:  # one refresher at a time; a stale lock (crash) is broken after 60s
        fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        try:
            if time.time() - os.stat(LOCK).st_mtime > 60:
                os.unlink(LOCK)
        except OSError:
            pass
        return snap, "" if snap else "refresh in progress"
    try:
        snap = {"at": int(time.time()), "sessions": [normalize(s) for s in fetch()]}
        tmp = SNAP + ".%d" % os.getpid()
        with open(os.open(tmp, os.O_CREAT | os.O_WRONLY, 0o600), "w") as f:
            json.dump(snap, f)
        os.replace(tmp, SNAP)  # atomic: readers see the old or the new file
        return snap, ""
    except Exception as e:
        return snap, str(e) if isinstance(e, RuntimeError) else type(e).__name__
    finally:
        os.unlink(LOCK)


def age(iso):  # api timestamps are UTC
    try:
        return max(0, int(time.time() - calendar.timegm(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))))
    except Exception:
        return -1


def fmt_age(s):
    if s < 0:
        return "?"
    return "%ds" % s if s < 60 else "%dm" % (s // 60) if s < 3600 else "%dh" % (s // 3600)


def cmd_lookup(argv):
    branch = argv[0] if argv else ""
    repo = slug(argv[1]) if len(argv) > 1 else ""
    snap, _ = refresh()
    best = None
    for s in (snap or {}).get("sessions", []):
        if s["state"] == "archived":
            continue
        if any(b == branch and (not repo or r == repo) for r, b in s["heads"]):
            if best is None or s["updated_at"] > best["updated_at"]:
                best = s
    if best:  # age in seconds: the caller decides how stale is still urgent
        secs = age(best["updated_at"])
        print("\t".join([best["state"], str(secs if secs >= 0 else 10 ** 9), best["url"]]))


def worktrees():
    """{branch: repo-dir-name} for every wt worktree. ~/.worktrees/<repo>/<branch>
    encodes both, so no git calls — a branch with slashes is just a deeper path."""
    root = os.path.expanduser("~/.worktrees")
    out = {}
    for g in glob.glob(os.path.join(root, "*", "**", ".git"), recursive=True):
        rel = os.path.relpath(os.path.dirname(g), root).split(os.sep)
        if len(rel) > 1:
            out["/".join(rel[1:])] = rel[0]
    return out


def repo_roots():
    """The parent dirs `wt add <bare-repo-name> <branch>` searches (WT_REPOS).
    Read out of wt's config, since wt does not export it. The file is shell, but
    a list of parent dirs is a quoted literal at worst — shlex drops the quotes
    and a trailing comment, then it word-splits like `for d in $WT_REPOS` does."""
    v = os.environ.get("WT_REPOS")
    if v is None:
        try:
            with open(os.path.expanduser("~/.config/wt/config")) as f:
                for line in f:
                    if line.startswith("WT_REPOS="):
                        v = line.split("=", 1)[1]
        except OSError:
            pass
    words = " ".join(shlex.split(v, comments=True)) if v else ""
    return [os.path.expanduser(os.path.expandvars(p)) for p in words.split()]


def clones():
    """{repo-dir-name: path} for every clone wt can reach: the ones under
    WT_REPOS, plus the ones an existing worktree points at (which may live
    outside it). A repo cloned nowhere stays unknown — the widget then just
    leaves out that row's action, since there is nothing to check out from."""
    out = {}
    for root in repo_roots():
        for g in glob.glob(os.path.join(root, "*", ".git")):
            out[os.path.basename(os.path.dirname(g))] = os.path.dirname(g)
    for g in glob.glob(os.path.expanduser("~/.worktrees/*/**/.git"), recursive=True):
        try:
            with open(g) as f:
                p = f.read().strip().split(":", 1)[-1].strip()
        except OSError:
            continue
        i = p.find("/.git/worktrees/")
        if i > 0:
            out[os.path.basename(p[:i])] = p[:i]
    return out


LEVEL = {"needs-you": "error", "failed": "error", "working": "ok",
         "your-turn": "warn", "done": "dim"}


def pick_head(heads, wt, repos):
    """(branch, repo-dir-name) for the row: heads repeats one branch under every
    repo of the session's environment, so the first pair is arbitrary. Prefer a
    pair we can act on — a branch we already have a worktree for, else a repo we
    have a clone of. Taking the first pair dropped the action for every session
    whose first repo happened to be one we had never checked out."""
    pairs = [(b, r.split("/")[-1]) for r, b in heads]
    # branch AND repo together: every pair carries the same branch, so matching
    # on the branch alone would always settle for pairs[0]'s arbitrary repo
    return next((p for p in pairs if wt.get(p[0]) == p[1]),
                next((p for p in pairs if p[1] in repos),
                     pairs[0] if pairs else ("", "")))


def cmd_json(_argv):
    """One card for the wt board plasmoid: a row per session, with an action."""
    snap, err = refresh()
    wt = worktrees()
    repos = clones()
    rows, counts = [], {}
    for s in (snap or {}).get("sessions", []):
        if s["state"] == "archived" or age(s["updated_at"]) >= MAX_AGE:
            continue
        counts[s["state"]] = counts.get(s["state"], 0) + 1
        head, repo = pick_head(s["heads"], wt, repos)
        row = {"state": s["state"].replace("-", " "), "level": LEVEL.get(s["state"], "normal"),
               "age": fmt_age(age(s["updated_at"])), "name": head or repo or "?",
               "title": s["title"], "note": s["needs_action"] or s["detail"] or "",
               # the web id, not the api's cse_ one: this is what a human pastes
               "session": s["url"].rsplit("/", 1)[-1], "url": s["url"]}
        if head in wt:  # already local: jump to its activity
            row.update(tag="local", execIcon="preferences-desktop-activities",
                       execTip="switch to this activity",
                       exec="%s switch %s" % (shlex.quote(WT), shlex.quote("%s: %s" % (wt[head], head))))
        elif head and repo in repos:  # know the clone: check it out
            row.update(execIcon="download", execTip="check out locally (wt add)",
                       exec="%s add %s %s" % (shlex.quote(WT), shlex.quote(repos[repo]),
                                              shlex.quote(head)))
        rows.append(row)
    urgent = counts.get("needs-you", 0) + counts.get("failed", 0)
    if urgent:
        badge = {"text": "%d need you" % urgent, "level": "error"}
    elif counts.get("working"):
        badge = {"text": "%d working" % counts["working"], "level": "ok"}
    else:
        badge = {"text": "%d active" % len(rows), "level": "dim"}
    sub = "%d in the last %s" % (len(rows), WINDOW)
    if err:
        sub = err
    elif snap and time.time() - snap.get("at", 0) > TTL * 4:
        sub = "snapshot %s old" % fmt_age(int(time.time() - snap["at"]))
    json.dump({"title": "claude.ai/code", "subtitle": sub, "badge": badge,
               "layout": "list", "rows": rows}, sys.stdout)
    return 0


def cmd_branch(argv):
    """A session id/url -> the branch it works on (pushed or not). Reverse of lookup."""
    key = (argv[0] if argv else "").rstrip("/").rsplit("/", 1)[-1].split("_", 1)[-1]
    repo = slug(argv[1]) if len(argv) > 1 else ""
    if not key:
        return 1
    for s in (refresh()[0] or {}).get("sessions", []):
        if s["id"].split("_", 1)[-1] != key:
            continue
        # heads repeats one branch under every repo of the environment, so a
        # repo filter usually changes nothing — but it disambiguates if it can
        names = list(dict.fromkeys(b for r, b in s["heads"] if not repo or r == repo))
        names = names or list(dict.fromkeys(b for _, b in s["heads"]))
        print("\n".join(names))
        return 0 if names else 1
    return 1


def cmd_list(hide, show_all=False):
    """hide: branch names to leave out (they have a local worktree already)."""
    snap, err = refresh()
    # WT_TTY: `wt list` captures this output, so our own isatty() says no even
    # though the text lands in a terminal. wt sets it only when its stdout is one.
    tty = sys.stdout.isatty() or os.environ.get("WT_TTY") == "1"
    def c(code, t):
        return "\033[%sm%s\033[0m" % (code, t) if tty else t
    def link(url, t):  # OSC 8 — ctrl/cmd-click opens the session
        return "\033]8;;%s\033\\%s\033]8;;\033\\" % (url, t) if tty and url else t
    if err:
        print(c("31", "cloud unavailable: " + err), file=sys.stderr)
    if not snap:
        return 1
    if time.time() - snap.get("at", 0) > TTL * 4:
        print(c("2", "snapshot %s old" % fmt_age(int(time.time() - snap["at"]))))
    skip = set(hide)
    live = [s for s in snap["sessions"]
            if s["state"] != "archived" and not any(b in skip for _, b in s["heads"])]
    # a week-old question sorted above a session that finished ten minutes ago
    # is noise, so old ones drop out entirely rather than crowding the top
    shown = [s for s in live
             if show_all or s["state"] == "working" or age(s["updated_at"]) < MAX_AGE]
    shown.sort(key=lambda s: s["updated_at"], reverse=True)  # stable: newest within rank
    shown.sort(key=lambda s: RANK.get(s["state"], 9))
    if not shown:  # stderr, so an embedding caller can drop its heading too
        print("no cloud sessions in the last %s" % WINDOW, file=sys.stderr)
        return 1
    # piped (wt list embeds us) there is no tty to measure — assume narrow
    width = shutil.get_terminal_size((100, 24)).columns
    for s in shown:
        code, g = GLYPH.get(s["state"], ("2", "?"))
        # the branch identifies the session and is what you'd hand to wt add;
        # the detail line is why you don't have to open the browser
        head = next((b for _, b in s["heads"]), "") or (s["repos"][0] if s["repos"] else "")
        # title first — the branch is generated, the title is what a human named
        # it; the note is a sentence and can lose its tail to the width
        note = "  —  ".join(t for t in (s["title"], s["needs_action"] or s["detail"]) if t)
        # never truncate the branch — it is what you paste into wt add
        room = max(20, width - 21 - max(45, len(head)))
        # pad before coloring — escape codes would eat the column width
        print("%s %s %4s  %s %s%s" % (
            c(code, g), c(code, s["state"].replace("-", " ").ljust(9)),
            fmt_age(age(s["updated_at"])), link(s["url"], c("1;4", head.ljust(45))),
            c("2", note[:room] + ("…" if len(note) > room else "")),
            c("36", " *") if s["unread"] else ""))
    if len(live) > len(shown):
        print(c("2", "%d older than %s not shown — wt cloud --all"
                % (len(live) - len(shown), WINDOW)))
    return 0


def main():
    argv = [a for a in sys.argv[1:] if a != "--all"]
    cmd = argv[0] if argv else "list"
    if cmd == "lookup":
        cmd_lookup(argv[1:])
    elif cmd == "branch":
        return cmd_branch(argv[1:])
    elif cmd == "json":
        return cmd_json(argv[1:])
    elif cmd == "raw":  # triage aid: this api drifts, see what it really said
        pat = argv[1] if len(argv) > 1 else ""
        json.dump([s for s in fetch() if pat in json.dumps(s)], sys.stdout, indent=2)
    elif cmd == "refresh":
        _, err = refresh(force=True)
        if err:
            print(err, file=sys.stderr)
            return 1
    elif cmd == "list":
        return cmd_list(argv[1:], "--all" in sys.argv[1:])
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
